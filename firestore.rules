rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidInspection(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.timestamp is number
        && data.complianceScore is number
        && data.complianceScore >= 0 && data.complianceScore <= 100;
    }

    function isValidNotice(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.inspectionId is string && data.inspectionId.size() > 0
        && data.noticeNumber is string && data.noticeNumber.size() > 0;
    }

    match /inspections/{inspectionId} {
      allow get, list: if true;
      allow create, update: if isValidId(inspectionId) && isValidInspection(request.resource.data);
      allow delete: if isValidId(inspectionId);
    }

    match /notices/{noticeId} {
      allow get, list: if true;
      allow create, update: if isValidId(noticeId) && isValidNotice(request.resource.data);
      allow delete: if isValidId(noticeId);
    }
  }
}
